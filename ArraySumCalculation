#include <stdio.h>

// 函式原型
long long sum(int arr[], int size);

int main() {
    int data[6] = {1000000000, 1000000000, 1000000000, 
                   1000000000, 1000000000, 1000000000};
    
    long long total = sum(data, 6);
    printf("Total = %lld\n", total);   // 正確輸出 6000000000

    return 0;
}

// 函式定義：使用 long long 防止整數溢位
long long sum(int arr[], int size) {
    long long total = 0;              // 必須用 long long
    int i;
    for (i = 0; i < size; i++) {
        total += arr[i];              // 累加
    }
    return total;
}

// 函式定義：使用暫時變數逐一交換
void swap_array_contents(int arr1[], int arr2[], int size) {
    int temp;
    int i;
    for (i = 0; i < size; i++) {
        temp = arr1[i];
        arr1[i] = arr2[i];
        arr2[i] = temp;
    }
}
