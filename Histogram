#include <stdio.h>
#define SIZE 5

int main() {
    int n[SIZE] = {19, 3, 15, 7, 11};
    int i, j;

    printf("%s%13s%17s\n", "Element", "Value", "Histogram");

    for (i = 0; i < SIZE; i++) {
        printf("%7d%13d        ", i, n[i]);   // 印出索引與數值

        // 印出對應數量的星號
        for (j = 0; j < n[i]; j++) {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
