#include <stdio.h>  // 引入標準輸入輸出函式庫，讓程式可以使用 printf()

#define M 4  // 定義 M = 4，代表矩陣 A 有 4 列（rows）
#define N 2  // 定義 N = 2，代表矩陣 A 有 2 行（columns）

int main(void)
{
    // 宣告並初始化矩陣 A，它有 M 列、N 行，也就是 4 列 2 行
    int A[M][N] = {
        { 2,  4},  // 第 0 列
        { 6,  8},  // 第 1 列
        {10, 12},  // 第 2 列
        {14, 16}   // 第 3 列
    };

    int B[N][M];  // 宣告矩陣 B，有 N 列、M 行，也就是 2 列 4 行
                  // B 用來儲存 A 的轉置矩陣（Transpose）

    // 外層迴圈：依序走訪矩陣 A 的每一列
    for (int i = 0; i < M; i++) {

        // 內層迴圈：依序走訪目前這一列的每一行
        for (int j = 0; j < N; j++) {

            B[j][i] = A[i][j];
            // 將 A 第 i 列、第 j 行的元素，放到 B 第 j 列、第 i 行
            // 也就是交換列與行的索引位置，完成矩陣轉置
        }
    }

    printf("Matrix B = A^T:\n");  // 輸出標題，A^T 表示 A 的轉置矩陣

    // 外層迴圈：依序走訪矩陣 B 的每一列
    for (int i = 0; i < N; i++) {

        // 內層迴圈：依序走訪目前這一列的每一行
        for (int j = 0; j < M; j++) {

            printf("%4d ", B[i][j]);
            // 輸出 B 第 i 列、第 j 行的元素
            // %4d 表示預留 4 個字元寬度來顯示整數，讓數字排列整齊
            // 空格則用來分隔各個數字

        }

        printf("\n");  // 一列輸出完畢後換行，開始輸出下一列
    }

    return 0;  // 回傳 0，表示程式正常結束
}
