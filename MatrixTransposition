#include <stdio.h>

#define M 4
#define N 2

int main(void)
{
    int A[M][N] = {
        { 2,  4},
        { 6,  8},
        {10, 12},
        {14, 16}
    };

    int B[N][M];
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            B[j][i] = A[i][j];
        }
    }

    printf("Matrix B = A^T:\n");
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            printf("%4d ", B[i][j]);
        }
        printf("\n");
    }

    return 0;
}
