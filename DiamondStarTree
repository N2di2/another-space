
#include <stdio.h>  // 引入標準輸入輸出函式庫，讓程式可以使用 printf()

int main()  // 主函式，程式從這裡開始執行
{
    int i, j;  // 宣告迴圈變數 i 和 j
    int n = 5; // 設定菱形上半部的總列數為 5

    // 第一個大迴圈：印出菱形的上半部，包含最寬的一列
    for (i = 1; i <= n; i++)
    {
        // 印出每一列前面的空白
        // 第 1 列印 4 個空白，第 2 列印 3 個，依此類推
        for (j = 1; j <= n - i; j++)
        {
            printf(" ");  // 印出一個空白，不換行
        }

        // 印出每一列的星號
        // 第 1 列印 1 顆，第 2 列印 3 顆，依此類推
        for (j = 1; j <= 2 * i - 1; j++)
        {
            printf("*");  // 印出一顆星號，不換行
        }

        printf("\n");  // 目前這一列印完後，換到下一列
    }

    // 第二個大迴圈：印出菱形的下半部
    // 從 n - 1 開始，避免再次印出最寬的一列
    // i 每次減 1，讓星號逐漸減少
    for (i = n - 1; i >= 1; i--)
    {
        // 印出每一列前面的空白
        // 隨著 i 變小，空白數量逐漸增加
        for (j = 1; j <= n - i; j++)
        {
            printf(" ");  // 印出一個空白，不換行
        }

        // 印出每一列的星號
        // 星號數量為 2 * i - 1，會逐漸減少
        for (j = 1; j <= 2 * i - 1; j++)
        {
            printf("*");  // 印出一顆星號，不換行
        }

        printf("\n");  // 目前這一列印完後，換到下一列
    }

    return 0;  // 回傳 0，表示程式正常結束
}
