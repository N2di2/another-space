#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    // 設定隨機數種子
    srand(time(NULL));

    // 產生 1 到 100 的秘密數字
    int secret = rand() % 100 + 1;

    int low = 1;      // 目前有效範圍下限
    int high = 100;   // 目前有效範圍上限
    int guess;        // 使用者猜測的數字

    printf("=== Hi-Lo Number Guessing Game ===\n");
    printf("The secret number has decided(1~100), let's start now!\n");

    // 連續遊戲迴圈
    while (1) {
        printf("\nThe valid range is: The number is between [%d] and [%d]\n", low, high);
        printf("Please enter your guess: ");
        scanf("%d", &guess);

        if (guess < secret) {
            // 猜太小，更新下限
            low = guess + 1;
            printf("Too small!\n");
        } else if (guess > secret) {
            // 猜太大，更新上限
            high = guess - 1;
            printf("Too large!\n");
        } else {
            // 猜中
            printf("Congratulations! The secret number is %d\n", secret);
            break;
        }
    }

    return 0;
}
