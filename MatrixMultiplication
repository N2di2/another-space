
#include <stdio.h>  // 引入標準輸入輸出函式庫，讓程式可以使用 printf() 輸出結果

#define M 2  // 定義 M = 2，代表矩陣 A 有 2 列（rows）
#define K 2  // 定義 K = 2，代表矩陣 A 有 2 行（columns），也是矩陣 B 的列數
#define N 2  // 定義 N = 2，代表矩陣 B 有 2 行（columns）

int main(void)  // 主函式，程式從這裡開始執行
{
    // 宣告矩陣 A，大小為 M × K，也就是 2 列 2 行
    int A[M][K] = {
        {1, 2},  // 矩陣 A 的第 1 列
        {3, 4}   // 矩陣 A 的第 2 列
    };

    // 宣告矩陣 B，大小為 K × N，也就是 2 列 2 行
    int B[K][N] = {
        {2, 4},  // 矩陣 B 的第 1 列
        {6, 8}   // 矩陣 B 的第 2 列
    };

    // 宣告矩陣 C，大小為 M × N，並將所有元素初始化為 0
    // 矩陣乘法的計算結果會存放在 C 裡面
    int C[M][N] = {0};

    // 外層迴圈：依序處理矩陣 C 的每一列
    for (int i = 0; i < M; i++) {

        // 中層迴圈：依序處理矩陣 C 的每一行
        for (int j = 0; j < N; j++) {

            // 內層迴圈：計算 C[i][j] 所需要的乘積總和
            for (int k = 0; k < K; k++) {

                // 將 A 的第 i 列與 B 的第 j 行中，
                // 對應位置的元素相乘，再累加到 C[i][j]
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    // 輸出標題，\n 代表換行
    printf("Matrix C = A × B:\n");

    // 外層迴圈：依序輸出矩陣 C 的每一列
    for (int i = 0; i < M; i++) {

        // 內層迴圈：依序輸出目前這一列的每個元素
        for (int j = 0; j < N; j++) {

            // %4d 表示以整數格式輸出，並預留至少 4 個字元的寬度
            // 讓每個數字對齊，方便閱讀矩陣
            printf("%4d ", C[i][j]);
        }

        // 同一列的數字輸出完畢後，換到下一列
        printf("\n");
    }

    return 0;  // 回傳 0，表示程式正常結束
}
