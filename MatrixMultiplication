#include <stdio.h>

#define M 2
#define K 2
#define N 2

int main(void)
{
    int A[M][K] = {
        {1, 2},
        {3, 4}
    };

    int B[K][N] = {
        {2, 4},
        {6, 8}
    };

    int C[M][N] = {0};
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            for (int k = 0; k < K; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }

    printf("Matrix C = A × B:\n");
    for (int i = 0; i < M; i++) {
        for (int j = 0; j < N; j++) {
            printf("%4d ", C[i][j]);
        }
        printf("\n");
    }

    return 0;
}
