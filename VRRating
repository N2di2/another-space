#include <stdio.h>

int main() {
    // 20 筆評分資料
    int responses[20] = {1,2,6,4,8,5,9,7,8,10,6,3,8,7,6,5,6,7,8,6};
    int frequency[11] = {0};   // 索引 1~10 用來計數（0 不用）
    int i;

    // 統計頻率
    for (i = 0; i < 20; i++) {
        frequency[responses[i]]++;   // 對應分數 +1
    }

    // 輸出結果
    printf("Rating\tFrequency\n");
    printf("------\t---------\n");
    for (i = 1; i <= 10; i++) {
        printf("%d\t%d\n", i, frequency[i]);
    }

    return 0;
}
