
#include <stdio.h>  // 引入標準輸入輸出函式庫，讓程式可以使用 printf()

int main(void)  // 主函式，程式從這裡開始執行
{
    double pi = 0.0;     // 儲存目前計算出的圓周率近似值，初始值為 0
    double sign = 1.0;   // 控制每一項的正負號，初始為正號
    int n = 1;           // 記錄目前正在計算第幾項，從第 1 項開始

    int n1 = 0;  // 記錄 pi 第一次落在 [3.14, 3.15) 範圍時的項數
    int n2 = 0;  // 記錄 pi 第一次落在 [3.141, 3.142) 範圍時的項數
    int n3 = 0;  // 記錄 pi 第一次落在 [3.1415, 3.1416) 範圍時的項數
    int n4 = 0;  // 記錄 pi 第一次落在 [3.14159, 3.1416) 範圍時的項數
                 // 也用來判斷是否已經達到停止條件

    printf("Terms      pi\n");  // 輸出表格標題：計算項數與 pi 的近似值

    // 只要 n4 還是 0，就繼續計算
    // 當 pi 第一次落入指定範圍時，n4 會被記錄成項數，迴圈便會停止
    while (n4 == 0) {

        // 利用 Leibniz 級數逐項累加，計算 pi 的近似值
        // 每一項的形式為正負 4 / (2n - 1)
        pi = pi + sign * 4.0 / (2 * n - 1);

        // 將正負號反轉，讓下一項與目前這一項的符號相反
        // 例如：+1 變成 -1，-1 變成 +1
        sign = -sign;

        // 只顯示前 20 項的計算結果，避免輸出過多資料
        if (n <= 20)
            printf("%-10d %.6f\n", n, pi);
            // %-10d：輸出整數，靠左對齊，欄位寬度至少為 10
            // %.6f：輸出 pi 的近似值，顯示小數點後 6 位
            // \n：換行

        // 如果 n1 尚未記錄，且 pi 第一次落入 [3.14, 3.15) 範圍
        // 就把目前項數 n 記錄到 n1
        if (n1 == 0 && pi >= 3.14 && pi < 3.15)
            n1 = n;

        // 如果 n2 尚未記錄，且 pi 落入 [3.141, 3.142) 範圍
        // 就把目前項數 n 記錄到 n2
        if (n2 == 0 && pi >= 3.141 && pi < 3.142)
            n2 = n;

        // 如果 n3 尚未記錄，且 pi 落入 [3.1415, 3.1416) 範圍
        // 就把目前項數 n 記錄到 n3
        if (n3 == 0 && pi >= 3.1415 && pi < 3.1416)
            n3 = n;

        // 如果 n4 尚未記錄，且 pi 落入 [3.14159, 3.1416) 範圍
        // 就把目前項數 n 記錄到 n4
        // n4 不再是 0 時，下一次檢查 while 條件就會結束迴圈
        if (n4 == 0 && pi >= 3.14159 && pi < 3.1416)
            n4 = n;

        n = n + 1;  // 項數加 1，準備計算下一項
    }

    // 輸出 pi 首次落入各個指定範圍時所使用的項數
    printf("\n3.14    : %d terms\n", n1);
    printf("3.141   : %d terms\n", n2);
    printf("3.1415  : %d terms\n", n3);
    printf("3.14159 : %d terms\n", n4);

    return 0;  // 回傳 0，表示程式正常結束
}

