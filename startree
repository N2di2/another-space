#include <stdio.h>

int main() {
    int i, j;  // i 控制外層迴圈（行數），j 控制內層迴圈（每行星星或空白的數量）

    // ========== 第一個圖形：左對齊的直角三角形（由上往下遞增） ==========
    // 輸出結果會像這樣：
    // *
    // **
    // ***
    // ...
    // **********
    for (i = 1; i <= 10; i++)          // 外層迴圈：從第 1 行跑到第 10 行
    {
        for (j = 1; j <= i; j++)       // 內層迴圈：每一行印出 i 顆星星
        {
            printf("%s", "*");
        }
        printf("\n");                  // 換行，準備印下一行
    }

    printf("\n");                      // 空一行，把圖形分開

    // ========== 第二個圖形：左對齊的直角三角形（由上往下遞減） ==========
    // 輸出結果會像這樣：
    // **********
    // *********
    // ********
    // ...
    // *
    for (i = 10; i >= 1; i--)          // 外層迴圈：從第 10 行跑到第 1 行
    {
        for (j = 1; j <= i; j++)       // 內層迴圈：每一行印出 i 顆星星
        {
            printf("%s", "*");
        }
        printf("\n");
    }

    printf("\n");

    // ========== 第三個圖形：右對齊的直角三角形（由上往下遞減） ==========
    // 輸出結果會像這樣：
    // **********
    //  *********
    //   ********
    //    ...
    //          *
    for (i = 10; i >= 1; i--)          // 外層迴圈：從第 10 行跑到第 1 行
    {
        // 先印空白：空白數量 = 10 - i（越下面空白越多，星星就越靠右）
        for (j = 1; j <= 10 - i; j++)
        {
            printf(" ");
        }
        // 再印星星：印出 i 顆
        for (j = 1; j <= i; j++)
        {
            printf("%s", "*");
        }
        printf("\n");
    }

    printf("\n");

    // ========== 第四個圖形：右對齊的直角三角形（由上往下遞增） ==========
    // 輸出結果會像這樣：
    //          *
    //         **
    //        ***
    //       ...
    // **********
    for (i = 1; i <= 10; i++)          // 外層迴圈：從第 1 行跑到第 10 行
    {
        // 先印空白：空白數量 = 10 - i（越上面空白越多，星星就越靠右）
        for (j = 1; j <= 10 - i; j++)
        {
            printf(" ");
        }
        // 再印星星：印出 i 顆
        for (j = 1; j <= i; j++)
        {
            printf("%s", "*");
        }
        printf("\n");
    }

    return 0;
}
